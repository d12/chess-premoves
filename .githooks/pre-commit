#!/bin/sh
# Installed by `npm install` (package.json "prepare" sets core.hooksPath=.githooks).
#
# 1. If the C++ sources of the WebAssembly opponent changed since the module was last built,
#    rebuild it and add it to this commit (needs Emscripten).
# 2. If the game's puzzle list is being committed, check every puzzle plays correctly.
#
# Skip once with `git commit --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"

if ! node scripts/wasm-stamp.mjs check >/dev/null 2>&1; then
  if command -v em++ >/dev/null 2>&1; then
    echo "pre-commit: WebAssembly opponent sources changed; rebuilding..."
    npm run --silent build:wasm
    git add src/engine/generated/premove-engine.js src/engine/generated/premove-engine.sources.sha256
    echo "pre-commit: rebuilt module added to this commit"
  else
    echo "pre-commit: the WebAssembly opponent is out of date (its C++ sources changed),"
    echo "            and em++ was not found to rebuild it."
    echo "            Install Emscripten (brew install emscripten) and run: npm run build:wasm"
    echo "            or commit anyway with: git commit --no-verify"
    exit 1
  fi
fi

if git diff --cached --name-only | grep -qx 'src/game/puzzles.json'; then
  echo "pre-commit: checking puzzles..."
  if ! node --test test/puzzles.test.js >/dev/null 2>&1; then
    node --test test/puzzles.test.js || true
    echo "pre-commit: a puzzle failed its check (see above); fix it with ./ppz app, or use --no-verify"
    exit 1
  fi
fi
