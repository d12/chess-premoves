{
  "name": "chess-premove",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "download:pieces": "node scripts/download-pieces.mjs",
    "build:wasm": "make -s --no-print-directory -C puzzle-finder/engine wasm && node scripts/wasm-stamp.mjs write",
    "check:wasm": "node scripts/wasm-stamp.mjs check && python3 puzzle-finder/tests/wasm_check.py",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  }
}
