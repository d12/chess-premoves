#!/usr/bin/env python3
"""Run the premove puzzle CLI without installing: ./ppz --help"""
import os
import sys

root = os.path.dirname(os.path.realpath(__file__))
venv = os.path.join(root, ".venv")
venv_python = os.path.join(venv, "bin", "python")
if os.path.exists(venv) and os.path.abspath(sys.executable) != venv_python:
    if not os.path.isfile(venv_python) or not os.access(venv_python, os.X_OK):
        sys.exit(f"Cannot run {venv_python}; recreate the puzzle-finder virtual environment.")
    os.execv(venv_python, [venv_python, os.path.realpath(__file__), *sys.argv[1:]])

sys.path.insert(0, root)
from premove_puzzles.cli import main  # noqa: E402

main()
